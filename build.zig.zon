.{
    // This is the default name used by packages depending on this one. For
    // example, when a user runs `zig fetch --save <url>`, this field is used
    // as the key in the `dependencies` table. Although the user can choose a
    // different name, most users will stick with this provided value.
    //
    // It is redundant to include "zig" in this name because it is already
    // within the Zig package namespace.
    .name = .zrk,
    // This is a [Semantic Version](https://semver.org/).
    // In a future version of Zig it will be used for package deduplication.
    .version = "2.3.0",
    // Together with name, this represents a globally unique package
    // identifier. This field is generated by the Zig toolchain when the
    // package is first created, and then *never changes*. This allows
    // unambiguous detection of one package being an updated version of
    // another.
    //
    // When forking a Zig project, this id should be regenerated (delete the
    // field and run `zig build`) if the upstream project is still maintained.
    // Otherwise, the fork is *hostile*, attempting to take control over the
    // original project's identity. Thus it is recommended to leave the comment
    // on the following line intact, so that it shows up in code reviews that
    // modify the field.
    .fingerprint = 0x614e97303b45a75a, // Changing this has security and trust implications.
    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.16.0",
    // This field is optional.
    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package, recursively.
    // Once all dependencies are fetched, `zig build` no longer requires
    // internet connectivity.
    .dependencies = .{
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio?ref=main#38206678edca2abf4e27ce18bb963bfa6f4297ab",
            .hash = "zio-0.17.0-xHbVVK-DKABkbm_XZgK-21SgNvYr9U5zr1MgOw7Q6JtM",
        },
        .h2 = .{
            .url = "git+https://github.com/zoxy-io/h2#ce82b9a886435d8fdd53e1a8cfbe72ed918fb53e",
            .hash = "h2-0.0.0--ngLtzZFBgCrbAucjP1hgw2-vJ2K12mf-04oR-EdzitD",
        },
        // The HTTP/1.1 response parser, shared with the zoxy benchmark harness
        // rather than hand-rolled a third time. zurl owns framing — chunked,
        // bodyless statuses, TE-beats-CL, conflicting Content-Length — and zrk
        // owns the request, which it builds once and replays: `writeRequest`
        // re-serializes per call, which measured 93-103 ns against 2.6 ns for
        // sending the prebuilt blob, so only the PARSER half is adopted here.
        //
        // It clears rule 6 the same way hparse cleared it for zurl: std-only
        // through `*Io.Reader`/`*Io.Writer`, with no runtime and no TLS stack
        // of its own, so it cannot put a second zio or a second libcrypto in
        // this graph. Its one transitive pin, hparse, is std-only too.
        .zurl = .{
            .url = "git+https://github.com/zoxy-io/zurl#4ecb1768985425d4f09b317f23f203983ef87d96",
            .hash = "zurl-0.0.0--VALCi1dBQA6i4gkVVX11IV13I784dueJYYAzyZZTBPz",
        },
        // TLS 1.3, and the libcrypto under it.
        //
        // zssl replaces the ztls fork plus the separate `openssl` pin this
        // manifest used to carry. Both of those are gone from here, and the
        // build.zig plumbing that went with them — the `libcrypto.a` alias
        // written so ztls's `linkSystemLibrary("crypto")` could find an
        // archive by that name, the include path pushed onto ztls's module,
        // the `crypto-pkg-config` opt-out that stopped a system OpenSSL's
        // headers from colliding with ours. zssl links its own libcrypto into
        // the module it exports, so a consumer imports one module and is done,
        // and cross-compilation keeps working because nothing is resolved from
        // the host.
        //
        // zssl is sans-I/O: it owns no socket, no allocator and no entropy.
        // What that buys is that the protocol state machine — where TLS CVEs
        // live — is auditable Zig, with libcrypto reduced to the constant-time
        // primitives. What it costs is that `src/tls.zig` is no longer a thin
        // wrapper: the `std.Io` adapter and the X.509 chain and hostname
        // verification are zrk's now, because zssl deliberately declines both.
        // That trade is the whole point of the swap; see src/tls.zig.
        //
        // A path dependency, not a URL: zssl is developed alongside zrk in the
        // same tree, and the client-origination work this depends on (RSA-PSS
        // leaves, the chain seam, ALPN lists) is what makes zrk able to point
        // at arbitrary HTTPS endpoints at all.
        .zssl = .{
            .path = "../zssl",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}
